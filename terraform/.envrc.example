# AWS credentials — loaded automatically by direnv when you cd into this folder.
# Fill in your values, then run:  direnv allow
#
# To find or create these keys:
#   AWS Console → IAM → Users → your user → Security credentials → Create access key
#   Choose "Command Line Interface (CLI)" as the use case.
#
# NEVER commit .envrc file. It is listed in .gitignore.

export AWS_ACCESS_KEY_ID="REPLACE_WITH_YOUR_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="REPLACE_WITH_YOUR_SECRET_ACCESS_KEY"
export AWS_DEFAULT_REGION="us-east-1"