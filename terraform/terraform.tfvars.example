# Copy this file to terraform.tfvars and fill in your values.
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is listed in .gitignore — it will NOT be committed to git.

# AWS region — must match the region where your EC2 instance will live.
# Common values: us-east-1, us-west-2, eu-west-1, ap-southeast-1, ap-northeast-1
aws_region = "us-east-1"

# EC2 instance type.
# t3.small  = 2 vCPU / 2 GB RAM — light personal use
# t3.medium = 2 vCPU / 4 GB RAM — recommended for teams (default)
instance_type = "t3.medium"

# YOUR public IP address followed by /32.
# This is the only IP that can SSH into the server.
# Find your IP by visiting: https://checkip.amazonaws.com
# Then paste it here like: "203.0.113.42/32"
your_ip_cidr = "YOUR_PUBLIC_IP/32"

# Your n8n subdomain — used as a tag on the EC2 instance for reference.
# Example: "n8n.example.com"
n8n_domain = "n8n.example.com"
