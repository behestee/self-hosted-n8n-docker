# =============================================================================
# n8n Environment Configuration
# Copy this file to .env and fill in every value before running setup.sh
#   cp .env.example .env && nano .env
# =============================================================================

# -----------------------------------------------------------------------------
# Setup Script Settings (used by setup.sh)
# -----------------------------------------------------------------------------

# Your server timezone — used to set the OS clock.
# Find your value at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: UTC  America/New_York  America/Los_Angeles  Europe/London  Asia/Kolkata
SETUP_TIMEZONE=UTC

# Your email address — Let's Encrypt sends certificate renewal alerts here.
SETUP_SSL_EMAIL=your@email.com

# Absolute path where this repository was cloned on the server.
# Only change this if you cloned to a different location than ~/n8n.
SETUP_INSTALL_DIR=/home/ec2-user/n8n

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres

# Strong password — use letters, numbers, and symbols (no spaces)
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=changePassword

POSTGRES_DB=n8n

POSTGRES_NON_ROOT_USER=pgn8nuser

# A different strong password from POSTGRES_PASSWORD
POSTGRES_NON_ROOT_PASSWORD=changePassword

# -----------------------------------------------------------------------------
# n8n Application
# -----------------------------------------------------------------------------

# Encryption key — used to encrypt all saved credentials in the database.
# CRITICAL: generate a new key and never change it after first run.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32

# Your n8n subdomain (must match your DNS A record and SSL certificate)
# Example: n8n.example.com
N8N_HOST=n8n.example.com

# Full webhook URL — same as N8N_HOST but with https:// prefix and trailing slash
WEBHOOK_URL=https://n8n.example.com/

# -----------------------------------------------------------------------------
# n8n Feature Flags (safe defaults — no need to change)
# -----------------------------------------------------------------------------

N8N_RUNNERS_ENABLED=true
N8N_PUSH_BACKEND=websocket
N8N_SECURE_COOKIE=true
N8N_PROXY_HOPS=1